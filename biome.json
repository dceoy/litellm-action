{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.js",
      "*.json",
      "*.mjs",
      "*.ts",
      ".oxlintrc.json",
      "biome.json",
      "scripts/**/*.js",
      "src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "useQwikValidLexicalScope": "off",
        "noNodejsModules": "off",
        "useImportExtensions": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": "off",
        "useExportsLast": "off",
        "noDefaultExport": "off",
        "noCommonJs": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["describe", "it", "expect", "jest", "beforeEach", "afterEach"]
  },
  "overrides": [
    {
      "includes": ["src/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off",
            "useTopLevelRegex": "off"
          },
          "style": {
            "useThrowOnlyError": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off",
            "noGlobalDirnameFilename": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
